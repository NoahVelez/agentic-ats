# Copy to .env and fill in what you need. Empty values are treated as unset.
# Never commit .env.

# --- Synthetic data generator (scripts/generate_data.py) ---
# Kept separate from the app's LLM_* variables so the generator uses a different model than the
# evaluator. Not needed with --offline. Read from the shell first, then from this file.
# Provider: openai | anthropic
DATAGEN_LLM_PROVIDER=
DATAGEN_LLM_MODEL=
DATAGEN_LLM_API_KEY=

# --- Embeddings (scripts/ingest.py and the server must use the same values) ---
# Provider:
#   fastembed  local ONNX model, no API key (the project's embedding model)
#   hash       offline word matching; tests and local development only, not for reported results
#   openai     any OpenAI-compatible /embeddings endpoint (needs EMBEDDING_API_KEY)
EMBEDDING_PROVIDER=
# For fastembed the default is BAAI/bge-small-en-v1.5
EMBEDDING_MODEL=
# Where fastembed keeps the downloaded model. Default: fastembed's own cache in the temp folder.
EMBEDDING_CACHE_DIR=
# Only for the openai provider. Never put an Anthropic key here.
EMBEDDING_API_KEY=
# Only for the openai provider. Default: https://api.openai.com/v1
EMBEDDING_BASE_URL=

# --- App LLM (agents) ---
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Paths (defaults: data/generated, chroma, runs) ---
DATA_DIR=
CHROMA_DIR=
RUNS_DIR=

# --- Service ---
# Default: http://localhost:8000/mcp/
MCP_URL=
# When set, /mcp requires "Authorization: Bearer <key>". Always set it on a public deployment.
MCP_API_KEY=
APP_API_KEY=
# Default: http://localhost:8000
API_BASE_URL=

# --- Caps (defaults: 3, 2, 3, 20, 300000, 1.00, 5) ---
MAX_SEARCH_ROUNDS=
MAX_VERIFY_ROUNDS=
MAX_CLARIFY_QUESTIONS=
MAX_POOL_SIZE=
RUN_TOKEN_BUDGET=
RUN_COST_BUDGET_USD=
EVAL_CONCURRENCY=
# Cosine-similarity threshold for a "strong hit", 0 to 1. Depends on the embedding model and the
# dataset; no default. Measure it with scripts/calibrate.py after ingest. Note: with bge-small it
# separates candidates poorly unless search is restricted to experience chunks (docs/mcp-server.md).
STRONG_HIT=
