# Copy to .env and fill in what you need. Empty values are treated as unset.
# Never commit .env.

# --- Synthetic data generator (scripts/generate_data.py) ---
# Kept separate from the app's LLM_* variables so the generator uses a different model than the
# evaluator. Not needed with --offline. The generator reads these from the shell environment.
# Provider: openai | anthropic
DATAGEN_LLM_PROVIDER=
DATAGEN_LLM_MODEL=
DATAGEN_LLM_API_KEY=

# --- Embeddings (scripts/ingest.py and the server must use the same values) ---
# Provider: openai (any OpenAI-compatible /embeddings endpoint) | hash (offline, word-matching
# only; for tests and local development, not for reported results)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# Default: https://api.openai.com/v1
EMBEDDING_BASE_URL=

# --- App LLM (agents) ---
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Paths (defaults: data/generated, chroma, runs) ---
DATA_DIR=
CHROMA_DIR=
RUNS_DIR=

# --- Service ---
# Default: http://localhost:8000/mcp/
MCP_URL=
# When set, /mcp requires "Authorization: Bearer <key>". Always set it on a public deployment.
MCP_API_KEY=
APP_API_KEY=
# Default: http://localhost:8000
API_BASE_URL=

# --- Caps (defaults: 3, 2, 3, 20, 300000, 1.00, 5) ---
MAX_SEARCH_ROUNDS=
MAX_VERIFY_ROUNDS=
MAX_CLARIFY_QUESTIONS=
MAX_POOL_SIZE=
RUN_TOKEN_BUDGET=
RUN_COST_BUDGET_USD=
EVAL_CONCURRENCY=
# Cosine-similarity threshold for a "strong hit", 0 to 1. Depends on the embedding model; no default.
STRONG_HIT=
